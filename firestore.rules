rules_version = '2';

// Lesen darf jeder (die Seite ist öffentlich). Schreiben darf nur, wer in der
// Sammlung "admins" mit seiner Google-E-Mail-Adresse als Dokument-ID steht.
// Besucher dürfen nur neue Anfragen über das Kontaktformular anlegen.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function text(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].trim().size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'message', 'createdAt'])
        && text('name', 100)
        && text('contact', 200)
        && text('message', 5000)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
