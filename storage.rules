rules_version = '2';

// Fotos darf jeder ansehen. Hochladen und Löschen darf nur, wer in der
// Firestore-Sammlung "admins" steht, und nur Bilder bis 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /images/{file} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
